#!/usr/bin/env ruby
require 'json'
require 'net/http'

world_name, place, kind = ARGV
abort 'usage: bin/zone WORLD PLACE KIND' unless kind

world      = JSON.parse(File.read("worlds/#{world_name}.json", encoding: 'UTF-8'))
lat0, lng0 = world['center']

uri    = URI("https://nominatim.openstreetmap.org/search?q=#{URI.encode_www_form_component(place)}&format=json&polygon_geojson=1&limit=1")
result = JSON.parse(Net::HTTP.get(uri, { 'User-Agent' => 'wijk-racer/0.1' })).first || abort("#{place} not found")

geometry = result['geojson']
ring = case geometry['type']
       when 'Polygon'      then geometry['coordinates'].first
       when 'MultiPolygon' then geometry['coordinates'].max_by { |polygon| polygon.first.size }.first
       else
         south, north, west, east = result['boundingbox'].map(&:to_f)
         [[west, south], [east, south], [east, north], [west, north]]
       end

points = ring.map { |lon, lat| [((lon - lng0) * 111_320 * Math.cos(lat0 * Math::PI / 180)).round(1), (-(lat - lat0) * 110_540).round(1)] }
world['zones'] = (world['zones'] || []).reject { |zone| zone['name'] == place } << { 'name' => place, 'kind' => kind, 'p' => points }
File.write("worlds/#{world_name}.json", JSON.generate(world))
warn "#{place} (#{result['display_name']}): #{points.size} points as #{kind}"
