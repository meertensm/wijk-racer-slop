#!/usr/bin/env ruby
require 'json'
require 'net/http'

world_name = ARGV[0] || abort('usage: bin/places WORLD')
world      = JSON.parse(File.read("worlds/#{world_name}.json", encoding: 'UTF-8'))
lat0, lng0 = world['center']
minx, minz, maxx, maxz = world['bounds']
cos = Math.cos(lat0 * Math::PI / 180)
south, north = lat0 - maxz / 110_540.0, lat0 - minz / 110_540.0
west,  east  = lng0 + minx / (111_320.0 * cos), lng0 + maxx / (111_320.0 * cos)

PRIORITY = %w[supermarket doityourself station skatepark park playground sports_centre swimming_pool stadium fuel fast_food mall
              garden_centre furniture cinema theatre hospital townhall school place_of_worship]
LABELS   = { 'skatepark' => 'Skatebaan', 'park' => 'Park', 'playground' => 'Speeltuin', 'station' => 'Station', 'sports_centre' => 'Sportpark',
             'swimming_pool' => 'Zwembad', 'stadium' => 'Stadion', 'fuel' => 'Tankstation' }

query = <<~QL
  [out:json][timeout:120];
  (
    node["place"]["name"](#{south},#{west},#{north},#{east});
    nwr["amenity"]["name"](#{south},#{west},#{north},#{east});
    nwr["shop"]["name"](#{south},#{west},#{north},#{east});
    nwr["tourism"]["name"](#{south},#{west},#{north},#{east});
    nwr["leisure"~"^(park|stadium|sports_centre|swimming_pool|playground|skatepark)$"](#{south},#{west},#{north},#{east});
    nwr["leisure"="pitch"]["sport"="skateboard"](#{south},#{west},#{north},#{east});
    nwr["railway"="station"]["name"](#{south},#{west},#{north},#{east});
  );
  out center tags;
QL
elements = nil
6.times do |attempt|
  %w[https://overpass-api.de/api/interpreter https://overpass.kumi.systems/api/interpreter].each do |server|
    response = Net::HTTP.post_form(URI(server), data: query)
    if response.code == '200'
      elements = JSON.parse(response.body.force_encoding('UTF-8'))['elements']
      break
    end
    warn "#{server} answered #{response.code}"
  end
  break if elements
  warn "Waiting 30 s before attempt #{attempt + 2}"
  sleep 30
end
abort 'Overpass unavailable' unless elements.is_a?(Array)

places = elements.filter_map do |element|
  tags = element['tags']
  lat  = element['lat'] || element.dig('center', 'lat')
  lon  = element['lon'] || element.dig('center', 'lon')
  next unless lat
  kind = tags['sport'] == 'skateboard' ? 'skatepark' : tags['place'] || tags['railway'] || tags['amenity'] || tags['shop'] || tags['tourism'] || tags['leisure']
  name = tags['name'] || LABELS[kind]
  next unless name
  rank = PRIORITY.index(kind) || 99
  { 'name' => name, 'kind' => kind, 'rank' => rank,
    'x' => ((lon - lng0) * 111_320 * cos).round(1), 'z' => (-(lat - lat0) * 110_540).round(1) }
end

towns = places.select { |place| %w[town village].include?(place["kind"]) }
places.each { |place| place['town'] = towns.min_by { |town| Math.hypot(town['x'] - place['x'], town['z'] - place['z']) }&.dig('name') }
places.group_by { |place| place['name'] }.each_value { |group| group.each_with_index { |place, i| place['name'] += " #{i + 1}" if i > 0 } }
buckets = places.select { |place| PRIORITY.include?(place['kind']) }.group_by { |place| place['kind'] }
                .sort_by { |kind, _| PRIORITY.index(kind) }.map { |_, group| group.sort_by { |place| place['name'] }.first(12) }
places = []
places.concat(buckets.filter_map(&:shift)) while places.size < 100 && buckets.any?(&:any?)
places = places.first(100)
world['places'] = places.map { |place| place.reject { |key, _| key == 'rank' } }
File.write("worlds/#{world_name}.json", JSON.generate(world))
warn "#{world['places'].size} places: #{world['places'].first(8).map { |p| p['name'] }.join(', ')}..."
