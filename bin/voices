#!/usr/bin/env ruby
require 'json'
require 'net/http'

root = File.expand_path('..', __dir__)
%w[geometry grid entity entities/structure entities/road entities/plant entities/vehicle entities/zone entities/spot entities/place entities/poop
   world voice npc npcs/humanoid_npc npcs/beagle npcs/labradoodle npcs/dog_walker npcs/bald_man npcs/zwerver npcs/junkie npcs/zombie npcs/speakerboy npcs/tattoo_man npcs/politie
   population].each { |file| require "#{root}/server/#{file}" }

key    = ENV.fetch('AZURE_SPEECH_KEY') { abort 'Set AZURE_SPEECH_KEY (and optionally AZURE_SPEECH_REGION, default westeurope)' }
region = ENV.fetch('AZURE_SPEECH_REGION', 'westeurope')

VOICES  = { male: 'nl-NL-MaartenNeural', female: 'nl-NL-FennaNeural' }
MOODS   = {
  angry: { rate: '+25%', pitch: '+10%', volume: '+60%', emphasis: 'strong' },
  happy: { rate: '+5%',  pitch: '+15%', volume: '+20%', emphasis: 'moderate' }
}
EFFECTS = {
  'scream' => { voice: 'nl-NL-MaartenNeural', rate: '-20%', pitch: '+50%', volume: '+70%',
                lines: ['AAAAAAAAAAAH! KANKER!', 'NEE! NEE! NEEEEEEEE! GODVERDOMME!', 'AAAAAARGH! GODVERDEKANKER!', 'OOOOOOH! MIJN KUTBEEEEEEN!'] },
  'zombie' => { voice: 'nl-NL-MaartenNeural', rate: '-50%', pitch: '-50%', volume: '+50%',
                lines: ['UUUUUUUUHHHHHH!', 'HERSENEN! HERSENEN! HERSENEN!', 'GRAAAAAAAAUUUUWWWW!'] }
}

http = Net::HTTP.new("#{region}.tts.speech.microsoft.com", 443)
http.use_ssl = true

render = lambda do |path, voice, text, rate:, pitch:, volume:, emphasis: 'strong'|
  next if File.exist?(path)
  ssml = <<~SSML
    <speak version="1.0" xmlns="http://www.w3.org/2001/10/synthesis" xml:lang="#{voice[/^[a-z]+-[A-Z]+/]}">
      <voice name="#{voice}"><prosody rate="#{rate}" pitch="#{pitch}" volume="#{volume}"><emphasis level="#{emphasis}">#{text.encode(xml: :text)}</emphasis></prosody></voice>
    </speak>
  SSML
  request = Net::HTTP::Post.new('/cognitiveservices/v1', 'Ocp-Apim-Subscription-Key' => key, 'Content-Type' => 'application/ssml+xml', 'X-Microsoft-OutputFormat' => 'audio-24khz-96kbitrate-mono-mp3', 'User-Agent' => 'wijk-racer')
  request.body = ssml
  response = http.request(request)
  abort "#{response.code} #{response.body}" unless response.is_a?(Net::HTTPSuccess)
  File.binwrite(path, response.body)
  puts path
end

Population::CLASSES.each do |kind, klass|
  klass::GENDERS.each do |gender|
    klass::LINES.each do |mood, lines|
      voice = klass.const_defined?(:TTS_VOICE) ? klass::TTS_VOICE : VOICES.fetch(gender)
      lines.each_with_index { |text, index| render.call("#{root}/assets/sounds/voice-#{kind}-#{gender}-#{mood}-#{index + 1}.mp3", voice, text, **MOODS.fetch(mood)) }
    end
  end
end

EFFECTS.each do |name, set|
  set[:lines].each_with_index { |text, index| render.call("#{root}/assets/sounds/#{name}#{index + 1}.mp3", set[:voice], text, rate: set[:rate], pitch: set[:pitch], volume: set[:volume]) }
end
